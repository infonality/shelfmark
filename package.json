{
  "name": "shelfmark",
  "private": true,
  "license": "MIT",
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "fixtures:epub": "node tests/epub/generate-fixtures.mjs",
    "test:epub:unit": "npm run fixtures:epub && vitest run --config vitest.config.ts",
    "test:epub:browser": "playwright test -c playwright.epub.config.ts",
    "test:epub": "npm run test:epub:unit && npm run test:epub:browser",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^30.1.0",
    "jszip": "^3.10.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "nanoid": "3.3.19",
    "postcss": "8.5.28"
  }
}
